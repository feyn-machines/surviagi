<https://openaiwill.com/ontology#vocabulary/source_role>
  a skos:ConceptScheme ;
  skos:prefLabel "Source role"@en, "来源角色"@zh-cn .

<https://openaiwill.com/ontology#vocabulary/source_role/primary>
  a skos:Concept ;
  skos:inScheme <https://openaiwill.com/ontology#vocabulary/source_role> ;
  skos:notation "primary" ;
  skos:prefLabel "Primary"@en, "主要"@zh-cn ;
  skos:definition "The post the update is mainly drawn from."@en, "更新主要依据的帖子。"@zh-cn .

<https://openaiwill.com/ontology#vocabulary/source_role/corroborating>
  a skos:Concept ;
  skos:inScheme <https://openaiwill.com/ontology#vocabulary/source_role> ;
  skos:notation "corroborating" ;
  skos:prefLabel "Corroborating"@en, "佐证"@zh-cn ;
  skos:definition "Supports the same update."@en, "佐证同一条更新。"@zh-cn .

<https://openaiwill.com/ontology#vocabulary/source_role/context>
  a skos:Concept ;
  skos:inScheme <https://openaiwill.com/ontology#vocabulary/source_role> ;
  skos:notation "context" ;
  skos:prefLabel "Context"@en, "背景"@zh-cn ;
  skos:definition "Gives background only."@en, "只提供背景。"@zh-cn .

<https://openaiwill.com/ontology#vocabulary/evidence_sign>
  a skos:ConceptScheme ;
  skos:prefLabel "Evidence sign"@en, "证据方向"@zh-cn .

<https://openaiwill.com/ontology#vocabulary/evidence_sign/positive>
  a skos:Concept ;
  skos:inScheme <https://openaiwill.com/ontology#vocabulary/evidence_sign> ;
  skos:notation "positive" ;
  skos:prefLabel "Positive"@en, "正向"@zh-cn ;
  skos:definition "Shows the work being done at the observed level."@en, "表明工作在所观察的级别上被完成。"@zh-cn .

<https://openaiwill.com/ontology#vocabulary/evidence_sign/negative>
  a skos:Concept ;
  skos:inScheme <https://openaiwill.com/ontology#vocabulary/evidence_sign> ;
  skos:notation "negative" ;
  skos:prefLabel "Negative"@en, "反向"@zh-cn ;
  skos:definition "Shows a failure or a limit at that level."@en, "表明在该级别上失败或受限。"@zh-cn .

<https://openaiwill.com/ontology#vocabulary/concept_kind>
  a skos:ConceptScheme ;
  skos:prefLabel "Concept kind"@en, "概念类型"@zh-cn .

<https://openaiwill.com/ontology#vocabulary/concept_kind/market_group>
  a skos:Concept ;
  skos:inScheme <https://openaiwill.com/ontology#vocabulary/concept_kind> ;
  skos:notation "market_group" ;
  skos:prefLabel "Market group"@en, "领域"@zh-cn ;
  skos:definition "An editorial domain organizing related markets; not an industry weight or capability score."@en, "归拢相关赛道的编辑领域；不是行业权重，也不是能力分数。"@zh-cn .

<https://openaiwill.com/ontology#vocabulary/concept_kind/market>
  a skos:Concept ;
  skos:inScheme <https://openaiwill.com/ontology#vocabulary/concept_kind> ;
  skos:notation "market" ;
  skos:prefLabel "Market"@en, "赛道"@zh-cn ;
  skos:definition "An editorial market or service area grouping work that serves a related production or service need."@en, "一个编辑赛道或服务领域，把服务于同一类生产或服务需求的工作归在一起。"@zh-cn .

<https://openaiwill.com/ontology#vocabulary/concept_kind/work>
  a skos:Concept ;
  skos:inScheme <https://openaiwill.com/ontology#vocabulary/concept_kind> ;
  skos:notation "work" ;
  skos:prefLabel "Work"@en, "工作"@zh-cn ;
  skos:definition "A named scope of work, either an editorial work item or a source occupation task; matching labels do not establish identity."@en, "一项有名字的工作范围：编辑的工作条目，或来源职业的任务。名称相同不代表是同一项。"@zh-cn .

<https://openaiwill.com/ontology#vocabulary/concept_kind/occupation_group>
  a skos:Concept ;
  skos:inScheme <https://openaiwill.com/ontology#vocabulary/concept_kind> ;
  skos:notation "occupation_group" ;
  skos:prefLabel "Occupation group"@en, "职业大类"@zh-cn ;
  skos:definition "An O*NET occupation family used to organize source occupations."@en, "用来组织来源职业的 O*NET 职业大类。"@zh-cn .

<https://openaiwill.com/ontology#vocabulary/concept_kind/occupation>
  a skos:Concept ;
  skos:inScheme <https://openaiwill.com/ontology#vocabulary/concept_kind> ;
  skos:notation "occupation" ;
  skos:prefLabel "Occupation"@en, "职业"@zh-cn ;
  skos:definition "An O*NET occupation with its source identity and occupational description."@en, "一个 O*NET 职业，带来源身份和职业描述。"@zh-cn .

