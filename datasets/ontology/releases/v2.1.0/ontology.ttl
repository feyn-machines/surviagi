<https://openaiwill.com/ontology#vocabulary/model_role>
  a skos:ConceptScheme ;
  skos:prefLabel "Model's role in an update"@en, "模型在更新里的角色"@zh-cn .

<https://openaiwill.com/ontology#vocabulary/model_role/subject>
  a skos:Concept ;
  skos:inScheme <https://openaiwill.com/ontology#vocabulary/model_role> ;
