<https://openaiwill.com/ontology#vocabulary/model_role/distributed>
  a skos:Concept ;
  skos:inScheme <https://openaiwill.com/ontology#vocabulary/model_role> ;
  skos:notation "distributed" ;
  skos:prefLabel "Distributed"@en, "被分发"@zh-cn ;
  skos:definition "it becomes available on another platform, cloud or service"@en, "它在另一个平台、云或服务上可用了"@zh-cn .

<https://openaiwill.com/ontology#vocabulary/model_role/compared>
