{
  "openapi": "3.1.0",
  "info": {
    "title": "SurviAGI agent API",
    "version": "1.3.0",
    "description": "Read-only access to published SurviAGI records and key-gated submissions. Every record is machine-proposed unless its review state says otherwise; cite the source URLs, not our summaries. Entity field names, types and grades are in the JSON Schemas listed under `x-entities`.",
    "x-ontology-version": "2.5.0"
  },
  "servers": [
    {
      "url": "https://surviagi.com"
    }
  ],
  "x-entities": [
    {
      "name": "Concept",
      "schema": "/contract/v1/schemas/Concept.schema.json"
    },
    {
      "name": "Work",
      "schema": "/contract/v1/schemas/Work.schema.json"
    },
    {
      "name": "Occupation",
      "schema": "/contract/v1/schemas/Occupation.schema.json"
    },
    {
      "name": "Organization",
      "schema": "/contract/v1/schemas/Organization.schema.json"
    },
    {
      "name": "Person",
      "schema": "/contract/v1/schemas/Person.schema.json"
    },
    {
      "name": "SourceAccount",
      "schema": "/contract/v1/schemas/SourceAccount.schema.json"
    },
    {
      "name": "Event",
      "schema": "/contract/v1/schemas/Event.schema.json"
    },
    {
      "name": "Model",
      "schema": "/contract/v1/schemas/Model.schema.json"
    },
    {
      "name": "Provider",
      "schema": "/contract/v1/schemas/Provider.schema.json"
    },
    {
      "name": "Product",
      "schema": "/contract/v1/schemas/Product.schema.json"
    },
    {
      "name": "ProductAvailability",
      "schema": "/contract/v1/schemas/ProductAvailability.schema.json"
    },
    {
      "name": "Observation",
      "schema": "/contract/v1/schemas/Observation.schema.json"
    },
    {
      "name": "ObservationSource",
      "schema": "/contract/v1/schemas/ObservationSource.schema.json"
    },
    {
      "name": "ObservationFact",
      "schema": "/contract/v1/schemas/ObservationFact.schema.json"
    },
    {
      "name": "Topic",
      "schema": "/contract/v1/schemas/Topic.schema.json"
    },
    {
      "name": "TopicOption",
      "schema": "/contract/v1/schemas/TopicOption.schema.json"
    }
  ],
  "paths": {
    "/api/agent/search": {
      "get": {
        "operationId": "search",
        "summary": "Search published records.",
        "description": "Ranks updates, topics, evidence readings and public articles against the query. A search that finds nothing starts no research.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "description": "What to look for, in English or Chinese. `q` is accepted as an alias."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 8
            }
          },
          {
            "name": "types",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "update",
                  "question",
                  "evidence",
                  "article"
                ]
              }
            },
            "style": "form",
            "explode": false,
            "description": "Comma-separated record types. Default all."
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "approved",
                "preview"
              ]
            },
            "description": "For articles only."
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "zh-CN"
              ],
              "default": "en"
            },
            "description": "Language of page links and labels."
          }
        ],
        "responses": {
          "200": {
            "description": "Matching records.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "A parameter is missing or malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "At most 60 reads a minute from one address.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Article search is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/record": {
      "get": {
        "operationId": "getRecord",
        "summary": "Read one record in full.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 260
            },
            "description": "An id returned by search."
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "zh-CN"
              ],
              "default": "en"
            },
            "description": "Language of page links and labels."
          }
        ],
        "responses": {
          "200": {
            "description": "The record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecordResponse"
                }
              }
            }
          },
          "400": {
            "description": "A parameter is missing or malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No record with this id in the loaded release.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "At most 60 reads a minute from one address.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/observations": {
      "get": {
        "operationId": "queryObservations",
        "summary": "List observations, filtered, with counts over everything that matches.",
        "description": "Occupation and market select exactly the observations their pages list, so the counts equal the page's. Pages through the rows with `cursor`; a cursor of an earlier data release is refused.",
        "parameters": [
          {
            "name": "occupation",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Occupation id, O*NET code or name (English or Chinese)."
          },
          {
            "name": "market",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Market id, slug or name."
          },
          {
            "name": "task",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "Task id, e.g. oaw:task:21593."
          },
          {
            "name": "organization",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Organization id, actor key or exact actor name."
          },
          {
            "name": "subject",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Product or model key or id."
          },
          {
            "name": "evidence_types",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "vendor_claim",
                  "demonstration",
                  "own_use",
                  "measurement",
                  "production_use",
                  "statistic"
                ]
              }
            },
            "style": "form",
            "explode": false,
            "description": "Comma-separated; any of them."
          },
          {
            "name": "directions",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "ai_takes_on",
                  "human_still_needed",
                  "neutral"
                ]
              }
            },
            "style": "form",
            "explode": false,
            "description": "Comma-separated; any of them."
          },
          {
            "name": "outcomes",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "succeeded",
                  "partly",
                  "failed",
                  "not_stated"
                ]
              }
            },
            "style": "form",
            "explode": false,
            "description": "Comma-separated; any of them."
          },
          {
            "name": "review_states",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "machine_proposed",
                  "human_confirmed",
                  "human_rejected"
                ]
              }
            },
            "style": "form",
            "explode": false,
            "description": "Comma-separated; any of them."
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "strength",
                "newest"
              ],
              "default": "strength"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "`next_cursor` of the previous page."
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "zh-CN"
              ],
              "default": "en"
            },
            "description": "Language of page links and labels."
          }
        ],
        "responses": {
          "200": {
            "description": "One page of matching observations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationsResponse"
                }
              }
            }
          },
          "400": {
            "description": "A parameter is missing or malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No occupation or market matches; `candidates` lists near matches.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "At most 60 reads a minute from one address.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/summary": {
      "get": {
        "operationId": "occupationSummary",
        "summary": "Evidence statistics of one occupation or market, as its page states them.",
        "parameters": [
          {
            "name": "occupation",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Occupation id, O*NET code or name. Give this or market."
          },
          {
            "name": "market",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Market id, slug or name."
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "zh-CN"
              ],
              "default": "en"
            },
            "description": "Language of page links and labels."
          }
        ],
        "responses": {
          "200": {
            "description": "The statistics.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SummaryResponse"
                }
              }
            }
          },
          "400": {
            "description": "A parameter is missing or malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No occupation or market matches; `candidates` lists near matches.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "At most 60 reads a minute from one address.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Versions": {
        "type": "object",
        "description": "The four versions kept apart. A client that pins one of them can detect a change in any of them.",
        "properties": {
          "contract": {
            "type": "string",
            "description": "This contract: field names, types and grades."
          },
          "ontology": {
            "type": "string",
            "description": "The ontology schema the records conform to."
          },
          "method": {
            "type": [
              "string",
              "null"
            ],
            "description": "How progress and readings were computed."
          },
          "data": {
            "type": [
              "string",
              "null"
            ],
            "description": "The published data release the answer was read from."
          }
        },
        "required": [
          "contract",
          "ontology",
          "method",
          "data"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid",
              "rate",
              "not_found",
              "unavailable",
              "unauthorized",
              "forbidden",
              "quota"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "message"
        ]
      },
      "SearchResult": {
        "type": "object",
        "description": "One hit. Article hits carry extra revision fields (status, version, evidence cutoff).",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "update",
              "question",
              "evidence",
              "article"
            ]
          },
          "title": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "description": "What kind of text the snippet is; see `content_kinds`.",
            "enum": [
              "machine_summary",
              "post_quote",
              "machine_reading",
              "editorial_article"
            ]
          },
          "review": {
            "type": "string",
            "description": "Review state of the record. `machine_proposed_unreviewed` until a person confirms."
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "description": "The record's own date."
          },
          "organization": {
            "type": [
              "string",
              "null"
            ],
            "description": "The organization the record is about."
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "markdown_url": {
            "type": "string",
            "format": "uri"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Addresses of the original sources."
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "snippet",
          "content",
          "date",
          "organization",
          "url",
          "markdown_url",
          "sources"
        ]
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "total": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          },
          "release": {
            "type": "object",
            "description": "The loaded data release.",
            "properties": {
              "id": {
                "type": "string"
              },
              "generated_at": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "When the snapshot was built."
              },
              "method": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Method version."
              }
            }
          },
          "versions": {
            "$ref": "#/components/schemas/Versions"
          },
          "content_kinds": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "editorial_articles": {
            "type": [
              "object",
              "null"
            ],
            "description": "Article store availability and hit count; null when articles were not requested.",
            "properties": {
              "available": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "count": {
                "type": "integer"
              }
            }
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "query",
          "total",
          "results",
          "release",
          "versions",
          "content_kinds",
          "editorial_articles",
          "note"
        ]
      },
      "ObservationCounts": {
        "type": [
          "object",
          "null"
        ],
        "description": "Counts as of the data release's date; null when the release carries no observations (unknown, not zero).",
        "properties": {
          "as_of": {
            "type": [
              "string",
              "null"
            ],
            "description": "The release date the 30/90-day windows end on."
          },
          "total": {
            "type": "integer"
          },
          "by_evidence_type": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "by_direction": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "by_outcome": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "against": {
            "type": "integer",
            "description": "Saying a person is still needed, or that the AI fell short."
          },
          "last_30_days": {
            "type": "integer"
          },
          "last_90_days": {
            "type": "integer"
          },
          "undated": {
            "type": "integer"
          }
        },
        "required": [
          "as_of",
          "total",
          "by_evidence_type",
          "by_direction",
          "by_outcome",
          "against",
          "last_30_days",
          "last_90_days",
          "undated"
        ]
      },
      "ObservationSummary": {
        "type": "object",
        "description": "One observation as a list shows it. Read it in full with /api/agent/record.",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "observation"
            ]
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "description": "When it was said in public."
          },
          "evidence_type": {
            "type": "string",
            "enum": [
              "vendor_claim",
              "demonstration",
              "own_use",
              "measurement",
              "production_use",
              "statistic"
            ]
          },
          "evidence_type_label": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "ai_takes_on",
              "human_still_needed",
              "neutral"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "succeeded",
              "partly",
              "failed",
              "not_stated"
            ]
          },
          "task": {
            "type": "string",
            "description": "Machine-written: what was done."
          },
          "actor": {
            "type": "object"
          },
          "subject": {
            "type": [
              "string",
              "null"
            ]
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "what": {
                  "type": "string"
                },
                "quote": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "unit",
                "what",
                "quote"
              ]
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "quote": {
                  "type": "string"
                },
                "published_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "url",
                "quote",
                "published_at"
              ]
            }
          },
          "review_state": {
            "type": "string",
            "enum": [
              "machine_proposed",
              "human_confirmed",
              "human_rejected"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "markdown_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        },
        "required": [
          "id",
          "type",
          "date",
          "evidence_type",
          "direction",
          "outcome",
          "task",
          "actor",
          "subject",
          "facts",
          "sources",
          "review_state",
          "url",
          "markdown_url"
        ]
      },
      "ObservationsResponse": {
        "type": "object",
        "properties": {
          "published": {
            "type": "boolean",
            "description": "Whether the loaded release carries observations at all."
          },
          "filters": {
            "type": "object"
          },
          "total": {
            "type": [
              "integer",
              "null"
            ]
          },
          "counts": {
            "$ref": "#/components/schemas/ObservationCounts"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ObservationSummary"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
