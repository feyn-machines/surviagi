      "x-grade": "record",
      "x-shape": "view"
    },
    "investee_org_id": {
      "type": "string",
      "x-grade": "record",
      "x-shape": "view"
    },
    "stake": {
      "type": [
        "string",
        "null"
      ],
      "x-grade": "excerpt",
      "x-ontology-property": "invests_in.stake"
    },
    "started_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "x-grade": "excerpt",
      "x-ontology-property": "invests_in.started_on"
    },
    "ended_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "x-grade": "excerpt",
