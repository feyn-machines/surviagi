{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surviagi.com/contract/v1/schemas/Concept.schema.json",
  "title": "Catalog concept (market, work, occupation)",
  "x-title-zh-CN": "目录条目（赛道、工作、职业）",
  "description": "A sealed, identified entry of the world catalog: a market group, market, work, occupation group or occupation. The whole id is its identity.",
  "x-description-zh-CN": "世界目录里一个封存的、有标识的条目：赛道组、赛道、工作、职业大类或职业。整个 ID 就是它的身份。",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The whole id is the identity; it is never rebuilt from a label or a path.",
      "x-description-zh-CN": "整个 ID 是身份，不根据名称或路径重新生成。",
      "x-grade": "record",
      "x-ontology-property": "Concept.id"
    },
    "kind": {
      "type": "string",
      "enum": [
        "market_group",
        "market",
        "work",
        "occupation_group",
        "occupation"
      ],
      "description": "Which concept class the entry is. Decides the type; never guessed from the id.",
      "x-description-zh-CN": "条目属于哪个概念类。类型由它决定，不从 ID 里猜。",
      "x-grade": "record",
      "x-ontology-property": "Concept.kind"
    },
    "label_en": {
      "type": "string",
      "description": "English name.",
      "x-description-zh-CN": "英文名。",
      "x-grade": "excerpt",
      "x-ontology-property": "Concept.label_en"
    },
    "label_zh_cn": {
      "type": [
        "string",
        "null"
      ],
      "description": "Simplified Chinese name.",
      "x-description-zh-CN": "简体中文名。",
      "x-grade": "machine",
      "x-ontology-property": "Concept.label_zh_cn"
    },
    "origin": {
      "type": "string",
      "enum": [
        "editorial_ai",
        "onet_projection"
      ],
      "description": "Where the entry comes from.",
      "x-description-zh-CN": "条目的来源。",
      "x-grade": "record",
      "x-ontology-property": "Concept.origin"
    },
    "translation_status": {
      "type": "string",
      "enum": [
        "ai_translated",
        "pending",
        "source_original"
      ],
      "description": "State of the Chinese name.",
      "x-description-zh-CN": "中文名的状态。",
      "x-grade": "record",
      "x-ontology-property": "Concept.translation_status"
    },
    "scope_status": {
      "type": "string",
      "enum": [
        "starter_catalog",
        "defined",
        "source_missing_tasks"
      ],
      "description": "How far the entry's scope is defined.",
      "x-description-zh-CN": "条目范围定义到什么程度。",
      "x-grade": "record",
      "x-ontology-property": "Concept.scope_status"
    },
    "scope_note": {
      "type": [
        "string",
        "null"
      ],
      "description": "An editorial note on scope.",
      "x-description-zh-CN": "编辑的范围说明。",
      "x-grade": "machine",
      "x-ontology-property": "Concept.scope_note"
    },
    "definition": {
      "type": [
        "object",
        "null"
      ],
      "description": "Definition text with its language and basis; null when no existing source text applies.",
      "x-description-zh-CN": "定义文本，带语言和依据；没有现成来源文本时为空。",
      "x-grade": "excerpt",
      "x-ontology-property": "Concept.definition"
    }
  },
  "required": [
    "id",
    "kind",
    "label_en",
    "label_zh_cn",
    "origin",
    "translation_status",
    "scope_status",
    "scope_note",
    "definition"
  ],
  "additionalProperties": false,
  "x-identifier": "id"
}
