      "x-grade": "excerpt",
      "x-ontology-property": "Person.name"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Other spellings.",
      "x-description-zh-CN": "其他写法。",
      "x-grade": "excerpt",
      "x-ontology-property": "Person.aliases"
    },
    "identity_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "description": "Where the identity was established.",
      "x-description-zh-CN": "身份的出处。",
      "x-grade": "excerpt",
      "x-ontology-property": "Person.identity_url"
    }
  },
  "required": [
    "person_id",
    "name",
    "aliases",
    "identity_url"
  ],
  "additionalProperties": false,
  "x-identifier": "person_id"
