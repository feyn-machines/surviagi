# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# All environment files are local, including examples with real values.
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local skill runtime and credentials
**/.venv/
**/venv/
**/__pycache__/
*.pyc
**/.cache/

# Private agent tooling: never publish
.agents/
.claude/
.codex/
.lawrence/
.opencode/
skills/
AGENTS*.md
CLAUDE*.md
.mcp*.json
mcp.json
.claude.json*
# Credentials and local collection output
*.key
*.p12
*.pfx
cookies/
*cookies*.json
credentials*.json
auth.json
storage-state.json
storage_state.json
browser-state/
/data/
/private/
/tmp/
/logs/
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log

# Local bundles may contain credentials, raw captures or third-party materials.
*.zip
*.tar
*.gz
*.tgz
*.7z
*.rar

# Keep public data documentation; runtime data remains private.
!docs/data/
docs/data/*
!docs/data/*.md

# Local Docker persistence (Postgres + MLflow) — never commit
/infra/data/

# Locally generated website snapshot: machine-proposed, unreviewed data.
# The site renders without it (src/lib/snapshot.ts falls back when missing).
/datasets/published/

# Local-only tools kept out of Git (X login module: AGPL code and X script snapshots).
/local/

# local release staging
/.release/
